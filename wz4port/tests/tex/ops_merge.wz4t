op GenBitmap.Merge at 63,1 size 6x1 {
  name = merge_min
  Mode = min
}

op GenBitmap.Gradient at 70,0 size 3x1 {
  Size = 128, 128
  Flags = linear
  element { Pos = 0  Color = #ff000000 }
  element { Pos = 1  Color = #ffffffff }
}
op GenBitmap.Cell at 73,0 size 3x1 {
  Size = 128, 128
  Color0 = #ff000000
  Color1 = #ff909090
  Max = 16
  Seed = 3
  Mode = inner
}
// Correct: the exact complement of merge_min — the brighter of the two
// everywhere. min and max together must cover the pair with no overlap.
op GenBitmap.Merge at 70,1 size 6x1 {
  name = merge_max
  Mode = max
}

op GenBitmap.Gradient at 77,0 size 3x1 {
