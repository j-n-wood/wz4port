wz4t 1

// Stage 6.3 Suite A — the nine generators.
//
// Tesselation numbers are small, distinct per axis, and chosen so the face count
// is DERIVABLE rather than merely reproducible. Distinct per axis matters: a
// generator that swapped two axes would produce the same count with equal ones.
//
//   Cube(tx,ty,tz)          2*(tx*ty + tx*tz + ty*tz) quads
//   Grid(tx,ty)             tx*ty quads
//   Sphere(sl,sg)           sl*sg faces: 2*sl tris at the poles,
//                           sl*(sg-2) quads between
//   Cylinder(sl,sg,top)     sides + caps
//   Torus(sl,sg)            sl*sg quads, closed
//   Disc(sl)                a fan
//
// Text3D and Path3D are here for completeness and produce EMPTY meshes in this
// build, with a warning (patch 12). That is the assertion: empty, not absent,
// and not fatal. Stage 6.6 implements them.
//
// Import is given a path that does not exist, because the only import case that
// can live in the tree is one this suite writes itself — which 6.2 made
// possible and 6.3's own OBJ case does.

page "gen"

// 2*(2*3 + 2*4 + 3*4) = 2*26 = 52 quads. Scale 1 -> -0.5..0.5.
stack at 0,0 {
  op Wz4Mesh.Cube {
    name = g_cube
    Tesselate = 2, 3, 4
    Scale = 1, 1, 1
  }
}

// 3*5 = 15 quads. Grid is flat, so one axis has zero extent.
stack at 4,0 {
  op Wz4Mesh.Grid {
    name = g_grid
    Tesselate = 3, 5
    Sides = "-"
    Size = 1
  }
}

// 6*4 = 24 faces: 12 tris at the poles, 6*2 = 12 quads between.
stack at 8,0 {
  op Wz4Mesh.Sphere {
    name = g_sphere
    Slices = 6
    Segments = 4
    Diameter = 1, 1, 1
  }
}

// 5*3 = 15 quads. Closed, and the only generator whose closedness depends on a
// parameter — Arc below 1 leaves it open, so this uses the full turn.
stack at 12,0 {
  op Wz4Mesh.Torus {
    name = g_torus
    Slices = 5
    Segments = 3
    InnerRadius = 0.25
    OuterRadius = 0.5
    Phase = 0
    Arc = 1
  }
}

stack at 16,0 {
  op Wz4Mesh.Cylinder {
    name = g_cylinder
    Slices = 6
    Segments = 2
    Top = 1
    Radius = 0.5
    Height = 1
    Flags = centered, top, bottom
  }
}

stack at 20,0 {
  op Wz4Mesh.Disc {
    name = g_disc
    Slices = 7
    Radius = 0.5
    Phase = 0
    Flags = "-"
  }
}

// Empty, warned, not fatal. See patch 12.
stack at 24,0 {
  op Wz4Mesh.Text3D {
    name = g_text3d
    Text = "wz4"
    Font = "Arial"
    Height = 0.5
    Extrude = 0.1
  }
}

stack at 28,0 {
  op Wz4Mesh.Path3D {
    name = g_path3d
    Path = "M 0 0 L 1 0 L 1 1 z"
    Extrude = 0.1
  }
}

// A path that cannot exist, so the assertion is about how the failure is
// reported rather than about a file checked into the tree.
stack at 32,0 {
  op Wz4Mesh.Import {
    name = g_import_missing
    Filename = "does_not_exist.obj"
  }
}
