/****************************************************************************/
/***                                                                      ***/
/***   Materials, headless — wz4port, phase 9                              ***/
/***                                                                      ***/
/****************************************************************************/
//
// Registers the two material TYPES and the one operator that produces a
// material, so that geometry can carry a texture as far as the glTF exporter.
//
// WHY THIS MODULE EXISTS AT ALL
//
// Upstream declares these types in wz4frlib/wz4_mtrl2_ops.ops, which this build
// cannot compile: it reaches wz4_mtrl2_shader.hpp (generated by the asc shader
// compiler, not built here), wz4_demo2.hpp (the render graph) and wz4lib/doc.hpp
// (the gui). All three are out of scope by CLAUDE.md.
//
// But the CLASSES already exist headless — compat/include/wz4_mtrl_headless.hpp
// has concrete Wz4Mtrl and SimpleMtrl, and Wz4MeshCluster::Mtrl has been holding
// and refcounting them since phase 6. What was missing was only the registration
// that makes them reachable from the operator graph.
//
// wz4_mesh_ops.ops disabled SetMaterial with `headless = 0` and said why:
//
//   "Registering a phantom Wz4Mtrl type instead would be worse than omitting
//    this: nothing headless can produce a Wz4Mtrl, so the operator would appear
//    in the palette and never be usable."
//
// That objection was conditional, and this module removes the condition. The
// type stops being phantom the moment SimpleMaterial can build one.
//
// A .ops file in wz4port/ costs zero upstream changes — wz4_add_ops copies it
// into the build tree before running the generator (architecture.md A62). This
// is the second such module, after geo/animate_ops.ops.

header
{
#include "wz4_mtrl_headless.hpp"        // Wz4Mtrl, SimpleMtrl
#include "wz4frlib/wz3_bitmap_ops.hpp"  // GenBitmapType, for the texture input
#include "wz4frlib/wz3_bitmap_code.hpp" // GenBitmap
}

code
{
#include "wz4lib/basic.hpp"             // BitmapBase
}

/****************************************************************************/

// The base type. Deliberately spelled like upstream's (wz4_mtrl2_ops.ops:21) so
// that a document written against either build names the same thing, and so
// SetMaterial's `Wz4Mtrl` input resolves once that operator is re-enabled.
type Wz4Mtrl
{
  color = 0xff60e160;
  name = "wz4 Material";
  columnheader[0] = "Material";
}

// The concrete one. `notab` because it is reached through the Wz4Mtrl tab rather
// than having its own, which is upstream's arrangement too.
//
// No `gui`, no `render3d`, and no Init/Exit/Show: those exist upstream to draw a
// material preview sphere through the render graph. Nothing here renders, so a
// material's preview pane simply has nothing to show — which is honest, and
// better than a hook that pretends.
type SimpleMtrl : Wz4Mtrl
{
  name = "Simple Material";
  color = 0xff60e060;
  flags = notab;
}

/****************************************************************************/

// The producer.
//
// The input is a GenBitmap and NOT upstream's Texture2D. Upstream takes the
// uploaded GPU texture because it is about to bind it; here the bitmap itself is
// what matters, because a glTF image is encoded from pixels, and Texture2D's
// whole purpose — the upload — is the part this build does not have.
//
// Optional, so an untextured coloured material is expressible. The exporter
// needs that anyway: a mesh whose cluster has a material but no texture still
// gets a baseColorFactor.
//
// NOT NAMED SimpleMaterial, and the reason is a hazard worth stating. Upstream's
// wz4_mtrl2_ops.ops declares `SimpleMtrl SimpleMaterial(?Texture2D x3)` with 20
// parameter words, and its metadata IS loaded in this build — meta/corpus/ is
// where the mesh operators' metadata comes from, so the corpus is a deliverable
// despite its comment saying nothing consumes it. wMetaLibrary::Find returns the
// FIRST linear match by type and name (meta.cpp:385), so two operators sharing
// `SimpleMtrl.SimpleMaterial` would resolve by directory iteration order, and
// binding upstream's 20-word layout to this 2-word operator would write
// parameters past the end of it.
//
// Measured, not feared: `wz4gen describe SimpleMtrl.SimpleMaterial` returned
// upstream's Flags/Blend/Texture0 panel while this operator was still named that.
//
// The TYPE names stay as upstream's on purpose — types carry no parameter
// layout, so a duplicate is cosmetic, and SetMaterial's `Wz4Mtrl` input has to
// resolve to this type when stage 9.2 re-enables it.
operator SimpleMtrl TextureMaterial(?GenBitmap)
{
  tab = Wz4Mtrl;
  column = 0;
  parameter
  {
    color Colour = 0xffcccccc;

    // Wrap matters more than it looks. The Cube's UVs run 0..4 — one full tile
    // per face, in a continuous band around the four sides — so clamping would
    // smear the texture's edge column across three faces of every cube. Repeat
    // is the default for that reason, not by inertia.
    flags Wrap ("repeat|clamp");
  }
  code
  {
    // Type is set HERE rather than in the constructor, which is where upstream
    // does it. Upstream's material classes live in .cpp files that include their
    // own generated ops header, so `Type = SimpleMtrlType` is available to them;
    // ours is a header-only stand-in in compat/, deliberately kept free of any
    // dependency on generated code — wz4_mesh_ops.ops includes it, and a cycle
    // there would be worse than this line.
    //
    // wDocument checks the field on the operator's OUTPUT after the body runs
    // (doc.cpp:4336), so this is in time. The one object it does not cover is
    // Wz4MeshType_::Init's DefaultMtrl, which is constructed during type
    // registration — possibly before SimpleMtrlType exists — and is inert in this
    // build anyway: its only reader is the renderer, which is compiled out.
    out->Type = SimpleMtrlType;

    out->SetMtrl();
    out->Colour = para->Colour;
    out->Wrap = (para->Wrap==0);
    out->SetBitmap(0,in0);
    out->Name = cmd->Op->Name;
  }
}

/****************************************************************************/
